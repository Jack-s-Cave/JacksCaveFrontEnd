# Base URL of the Strapi backend (no trailing slash), e.g. http://localhost:1337 in dev.
REACT_APP_STRAPI_URL=http://localhost:1337

# Strapi API token used for every request (see src/services/api.ts).
# Generate one in the Strapi admin panel: Settings > API Tokens > Create new API Token.
# A "Read-only" token is enough for this frontend.
REACT_APP_STRAPI_TOKEN=
